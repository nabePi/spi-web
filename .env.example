# Base URL publik situs, dipakai untuk metadata (canonical URL, OpenGraph, dsb).
# - Local dev: http://localhost:3000
# - Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Payload CMS — generate a strong, unique secret: openssl rand -base64 32
PAYLOAD_SECRET=your-strong-secret-here

# --- Opsi 1: Docker Compose bawaan (Service 'db') ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_DB=spi_cms
# DATABASE_URI akan otomatis disusun dari variabel di atas jika dikosongkan pada docker compose:
# postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# --- Opsi 2: Database Eksternal (Managed Cloud / Host Postgres) ---
# Jika menggunakan database eksternal, uncomment baris di bawah:
# DATABASE_URI=postgresql://username:password@hostname:5432/spi_cms

# (Opsional) Mengaktifkan push skema otomatis Payload jika menggunakan DB eksternal kosong:
# DB_PUSH=false
