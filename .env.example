# Base URL publik situs, dipakai untuk metadata (canonical URL, OpenGraph, dsb).
# - Local dev: boleh dikosongkan, default ke http://localhost:3000
# - Staging: https://stg.pemikiranislam.id
# - Production: https://pemikiranislam.id
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payload CMS — generate a strong random secret: openssl rand -base64 32
PAYLOAD_SECRET=your-strong-secret-here
# SQLite (default for local dev). Change to postgres:// or mongodb:// for production.
DATABASE_URI=file:./data/payload.db

