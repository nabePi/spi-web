# Base URL publik situs (canonical URL, OpenGraph, dsb).
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Payload CMS — generate: openssl rand -base64 32
PAYLOAD_SECRET=your-strong-secret-here

# Koneksi ke PostgreSQL yang sudah ada di Dokploy (gunakan internal host/service name).
DATABASE_URI=postgresql://username:password@hostname:5432/spi_cms
